import pandas as pd

df = pd.read_csv("datos/metricas_simulacion.csv")
print(df.shape)
(df[df.escenario == "pico_matutino"]
   .groupby(["interseccion", "controlador"])[["espera_veh_media_s",
                                              "espera_peat_media_s"]]
   .mean().round(1))
